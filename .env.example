BOT_TOKEN="x.y.z"
PREFIX="sp!"
DATABASE_URL="postgres://user:password@localhost:5432/spagency"
STAFF_LOGS_CHANNEL="channel_id"
# production | testing | developing — defaults to production if unset/unrecognized (fails toward the
# most restrictive behavior). Gates dev-only commands like /cache — see src/systems/shared/Environment.ts.
BOT_ENV="production"

# See docs/verification.md for the full API contract the dashboard has to implement against.
# Signs/verifies verification tokens — never share this with the dashboard, it only needs to call the
# bot's HTTP API below, not decode tokens itself.
VERIFICATION_SECRET="a long random string"
# Server-to-server auth for POST /verify/:token/complete — the dashboard's backend sends this as
# `Authorization: Bearer <value>`. Also never exposed to the browser/end user.
VERIFICATION_API_KEY="another long random string"
# Base URL of the dashboard's verify page — the bot DMs "<this>/<token>" to whoever joins.
VERIFICATION_WEB_URL="https://dashboard.spagency.com/verify"
# Port the bot's verification API listens on, 127.0.0.1 only (same VPS as the dashboard).
VERIFICATION_SERVER_PORT="4501"
