BOT_TOKEN="x.y.z"
PREFIX="sp!"
DATABASE_URL="postgres://user:password@localhost:5432/spagency"
STAFF_LOGS_CHANNEL="channel_id"
# production | canary | developing — defaults to production if unset/unrecognized (fails toward the
# most restrictive behavior). Gates dev-only commands like /cache — see src/systems/shared/Environment.ts.
# Only `production` talks to the web: in the other two there is no API, no support tickets, no verification links.
# Dashboard configuration still reaches them all, through the shared database.
BOT_ENV="production"

# Web <-> bot — see docs/api.md. One HTTP server, one shared key, for everything the web needs from the bot.
# Port the bot's HTTP API listens on, 127.0.0.1 only (same VPS as the web).
BOT_API_PORT="4501"
# Shared secret between the bot and the web, used in BOTH directions: the web sends it as
# `Authorization: Bearer <value>` to this API, and the bot sends it to the web when pushing support
# transcripts. Must match INTERNAL_API_KEY in the web's .env. Never exposed to the browser/end user.
INTERNAL_API_KEY="a long random string"
# Base URL of the web, used by the bot to call it (support transcripts).
WEB_URL="http://127.0.0.1:4321"

# See docs/verification.md for the full API contract the dashboard has to implement against.
# Signs/verifies verification tokens — bot only, never share this with the web: it calls the bot's HTTP
# API instead of decoding tokens itself, which is what keeps the bot the sole authority over them.
VERIFICATION_SECRET="another long random string"
# Base URL of the dashboard's verify page — the bot DMs "<this>/<token>" to whoever joins.
VERIFICATION_WEB_URL="https://dashboard.spagency.com/verify"

# Support tickets (web <-> Discord) — see docs/support.md. The feature stays off, with a warning at startup,
# unless every one of these (and INTERNAL_API_KEY / WEB_URL / STAFF_LOGS_CHANNEL above) is set.
# Transcript copies for the staff, and alerts when the web doesn't confirm one, go to STAFF_LOGS_CHANNEL.
SUPPORT_GUILD_ID="guild_id"
SUPPORT_CATEGORY_ID="category_id"
SUPPORT_STAFF_ROLE_ID="role_id"

# Links shown by /info. Both are optional: a missing or invalid one is left out.
# Public address of the web, what a user can open (WEB_URL above is where the bot reaches it from the server, not for users). /donate is appended for the donation link.
WEB_PUBLIC_URL="https://spagency.example"
# Invitation to the support server.
SUPPORT_INVITE_URL="https://discord.gg/example"
